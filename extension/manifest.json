{
  "manifest_version": 3,
  "name": "Munshi",
  "version": "1.0.0",
  "description": "Your site analyst in Chrome's side panel, on any tab.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "action": { "default_title": "Open Munshi" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" }
}
